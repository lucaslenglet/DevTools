<Project>

  <PropertyGroup>
    <!-- Single source of the package version. The release workflow overrides it from the tag
         (v1.2.3 -> 1.2.3); local and CI builds keep this placeholder. -->
    <DevToolsVersion Condition="'$(DevToolsVersion)' == ''">0.0.0-local</DevToolsVersion>
  </PropertyGroup>

</Project>
